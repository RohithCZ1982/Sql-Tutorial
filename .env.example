# ---------------------------------------------------------------------------
# Database (Neon)
#
# Neon gives you two connection strings in the dashboard. Use BOTH:
#   DATABASE_URL -> the POOLED string (host contains "-pooler"). The app uses
#                   this at runtime; it survives serverless connection churn.
#   DIRECT_URL   -> the DIRECT string (no "-pooler"). `prisma migrate` needs a
#                   session-level connection, which the pooler cannot provide.
# Keep ?sslmode=require on both for Neon.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Local Postgres instead of Neon:
# DATABASE_URL="postgresql://postgres@127.0.0.1:5432/sqlplay"
# DIRECT_URL="postgresql://postgres@127.0.0.1:5432/sqlplay"

# Signs nothing by itself, but is mixed into session token hashing.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# The seed script creates this admin account if it does not already exist.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-seeding"
